package com.tomgregory;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

public class SimpleCalculatorAddTest {
    SimpleCalculator calculator = new SimpleCalculator();
    @Test
    @Tag("valid")
    public void testAdditionOfPositiveIntegers() {
        int result = calculator.add(5, 3);
        assertEquals(8, result);
    }
    @Test
    @Tag("valid")
    public void testAdditionOfNegativeIntegers() {
        int result = calculator.add(-5, -3);
        assertEquals(-8, result);
    }
    @Test
    @Tag("valid")
    public void testAdditionOfZeroAndPositiveInteger() {
        int result = calculator.add(0, 7);
        assertEquals(7, result);
    }
    @Test
    @Tag("valid")
    public void testAdditionOfZeroAndNegativeInteger() {
        int result = calculator.add(0, -7);
        assertEquals(-7, result);
    }
    @Test
    @Tag("valid")
    public void testAdditionOfLargePositiveIntegers() {
        int result = calculator.add(1000000, 500000);
        assertEquals(1500000, result);
    }
    @Test
    @Tag("valid")
    public void testAdditionOfLargeNegativeIntegers() {
        int result = calculator.add(-1000000, -500000);
        assertEquals(-1500000, result);
    }
    @Test
    @Tag("valid")
    public void testAdditionWithOneZeroInput() {
        int result = calculator.add(0, 10);
        assertEquals(10, result);
    }
}