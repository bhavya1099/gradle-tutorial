package com.tomgregory;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import static org.junit.Assert.assertEquals;

public class SimpleCalculatorAddTest {
  
    private SimpleCalculator simpleCalculator = new SimpleCalculator();
    @Test
    @Category(Categories.valid.class)
    public void addTwoPositiveIntegers() {
        // Arrange
        int a = 5;
        int b = 3;
        
        // Act
        int result = simpleCalculator.add(a, b);
        
        // Assert
        assertEquals("Sum of two positive integers", 8, result);
    }
    @Test
    @Category(Categories.valid.class)
    public void addTwoNegativeIntegers() {
        // Arrange
        int a = -5;
        int b = -3;
        
        // Act
        int result = simpleCalculator.add(a, b);
        
        // Assert
        assertEquals("Sum of two negative integers", -8, result);
    }
    @Test
    @Category(Categories.valid.class)
    public void addPositiveAndNegativeInteger() {
        // Arrange
        int a = 5;
        int b = -3;
        
        // Act
        int result = simpleCalculator.add(a, b);
        
        // Assert
        assertEquals("Sum of a positive and a negative integer", 2, result);
    }
    @Test
    @Category(Categories.boundary.class)
    public void addNegativeAndPositiveLeadingToZero() {
        // Arrange
        int a = 5;
        int b = -5;
        
        // Act
        int result = simpleCalculator.add(a, b);
        
        // Assert
        assertEquals("Addition leading to zero", 0, result);
    }
    
    @Test
    @Category(Categories.valid.class)
    public void addZeroWithAnotherInteger() {
        // Arrange
        int a = 0;
        int b = 7;
        
        // Act
        int result = simpleCalculator.add(a, b);
        
        // Assert
        assertEquals("Zero added to another integer", 7, result);
    }
}