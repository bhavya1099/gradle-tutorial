package com.tomgregory;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

public class SimpleCalculatorAddTest {
    SimpleCalculator simpleCalculator = new SimpleCalculator();
    @Test
    @Tag("valid")
    public void testAddingTwoPositiveNumbers() {
        int result = simpleCalculator.add(5, 7);
        assertEquals(12, result);
    }
    @Test
    @Tag("valid")
    public void testAddingPositiveNumberAndZero() {
        int result = simpleCalculator.add(10, 0);
        assertEquals(10, result);
    }
    @Test
    @Tag("valid")
    public void testAddingNegativeAndPositiveNumbers() {
        int result = simpleCalculator.add(-3, 8);
        assertEquals(5, result);
    }
    @Test
    @Tag("valid")
    public void testAddingTwoNegativeNumbers() {
        int result = simpleCalculator.add(-12, -5);
        assertEquals(-17, result);
    }
    @Test
    @Tag("valid")
    public void testAddingLargeAndSmallPositiveNumbers() {
        int result = simpleCalculator.add(1000, 5);
        assertEquals(1005, result);
    }
}