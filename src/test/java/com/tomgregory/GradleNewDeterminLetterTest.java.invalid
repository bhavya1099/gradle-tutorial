package com.tomgregory;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertThrows;
import org.junit.jupiter.api.*;

public class GradleNewDeterminLetterTest {
    private GradleNew gradleNew = new GradleNew();
    @Test
    @Tag("boundary")
    public void testDeterminLetterForMinimumPassingGrade() {
        assertEquals('D', gradleNew.determinLetter(60));
    }
    @Test
    @Tag("invalid")
    public void testDeterminLetterForMaximumFailingGrade() {
        assertThrows(IllegalArgumentException.class, () -> gradleNew.determinLetter(-1));
    }
    @Test
    @Tag("valid")
    public void testDeterminLetterForGradeC() {
        assertEquals('C', gradleNew.determinLetter(75));
    }
    @Test
    @Tag("valid")
    public void testDeterminLetterForOutstandingGrade() {
        assertEquals('O', gradleNew.determinLetter(80));
    }
    @Test
    @Tag("valid")
    public void testDeterminLetterForFailingGrade() {
        assertEquals('F', gradleNew.determinLetter(55));
    }
}