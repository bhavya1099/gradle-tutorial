package com.tomgregory;
import static org.junit.Assert.assertEquals;
import org.junit.Test;
import org.junit.experimental.categories.Category;

public class GradleNewDeterminLetterTest {
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void throwExceptionForNegativeInput() {
        GradleNew gradleNew = new GradleNew();
        gradleNew.determinLetter(-1); // Arrange & Act
    }
    @Test
    @Category(Categories.boundary.class)
    public void returnsFGradeForZero() {
        GradleNew gradleNew = new GradleNew();
        char result = gradleNew.determinLetter(0); // Arrange & Act
        assertEquals('F', result); // Assert
    }
    @Test
    @Category(Categories.boundary.class)
    public void returnsFForJustBelowPassingGrade() {
        GradleNew gradleNew = new GradleNew();
        char result = gradleNew.determinLetter(59); // Arrange & Act
        assertEquals('F', result); // Assert
    }
    @Test
    @Category(Categories.valid.class)
    public void returnsDForLowestDPassingGrade() {
        GradleNew gradleNew = new GradleNew();
        char result = gradleNew.determinLetter(60); // Arrange & Act
        assertEquals('D', result); // Assert
    }
    @Test
    @Category(Categories.boundary.class)
    public void returnsCForJustBelowBGrade() {
        GradleNew gradleNew = new GradleNew();
        char result = gradleNew.determinLetter(79); // Arrange & Act
        assertEquals('C', result); // Assert
    }
    @Test
    @Category(Categories.integration.class)
    public void returnsOForUnspecifiedHighGrade() {
        GradleNew gradleNew = new GradleNew();
        char result = gradleNew.determinLetter(100); // Arrange & Act
        assertEquals('O', result); // Assert
    }
}