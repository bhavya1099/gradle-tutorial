package com.tomgregory;
import org.junit.Test;
import static org.junit.Assert.*;
import org.junit.experimental.categories.Category;

public class GradleNewDeterminLetterTest {
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void testWithNegativeInput() {
        GradleNew testInstance = new GradleNew();
        testInstance.determinLetter(-1);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGradeThatReturnsF() {
        GradleNew testInstance = new GradleNew();
        char result = testInstance.determinLetter(59);
        assertEquals('F', result);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGradeThatReturnsD() {
        GradleNew testInstance = new GradleNew();
        char result = testInstance.determinLetter(65);
        assertEquals('D', result);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGradeThatReturnsC() {
        GradleNew testInstance = new GradleNew();
        char result = testInstance.determinLetter(75);
        assertEquals('C', result);
    }
    @Test
    @Category(Categories.valid.class)
    public void testGradeThatReturnsO() {
        GradleNew testInstance = new GradleNew();
        char result = testInstance.determinLetter(85);
        assertEquals('O', result);
    }
}