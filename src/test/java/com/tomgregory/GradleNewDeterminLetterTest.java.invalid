package com.tomgregory;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class GradleNewDeterminLetterTest {
    GradleNew gradleNew = new GradleNew();
    @Test
    @Tag("valid")
    public void testDeterminLetterForPassingScore() {
        int numGrade = 85;
        assertEquals('O', gradleNew.determinLetter(numGrade));
    }
    @Test
    @Tag("valid")
    public void testDeterminLetterForCRange() {
        int numGrade = 75;
        assertEquals('C', gradleNew.determinLetter(numGrade));
    }
    @Test
    @Tag("valid")
    public void testDeterminLetterForDRange() {
        int numGrade = 65;
        assertEquals('D', gradleNew.determinLetter(numGrade));
    }
    @Test
    @Tag("valid")
    public void testDeterminLetterForFailingScore() {
        int numGrade = 55;
        assertEquals('F', gradleNew.determinLetter(numGrade));
    }
    @Test
    @Tag("invalid")
    public void testDeterminLetterForNegativeInput() {
        int numGrade = -5;
        assertThrows(IllegalArgumentException.class, () -> gradleNew.determinLetter(numGrade));
    }
}